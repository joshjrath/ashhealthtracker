# Railway → your service → Variables. Only the first two are needed; the
# rest is managed in the site's own Settings page. None are needed locally.
DATABASE_URL=${{Postgres.DATABASE_URL}}
APP_PASSWORD=choose-a-long-password

# Optional:
# SESSION_SECRET=   # otherwise generated once and kept in the database
# INGEST_TOKEN=     # a fallback upload token; normally create tokens in Settings
# PASSWORD_RESET=1  # only to recover a forgotten Settings password; remove after
